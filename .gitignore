# Secrets
.env
.env.local
.env.*.local
credentials.json
token.json
*.token_cache.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/

# .tmp/ caches — structure tracked, contents not
.tmp/search_cache/*.json
.tmp/web_cache/*
!.tmp/search_cache/README.md
!.tmp/web_cache/README.md
# .tmp/scripts/ IS tracked — shared utilities
!.tmp/scripts/**

# OS / IDE
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Keep .vscode/ settings
!.vscode/

# Don't ignore memory - it's persistent state
# (but DO ignore memory/birth_chart.json if it contains sensitive data)
