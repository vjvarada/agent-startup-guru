# Secrets
.env
.env.local
.env.*.local
credentials.json
token.json
*.token_cache.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/

# .tmp/ caches — structure tracked, contents not
.tmp/search_cache/*.json
.tmp/web_cache/*
!.tmp/search_cache/README.md
!.tmp/web_cache/README.md
# .tmp/scripts/ IS tracked — shared utilities
!.tmp/scripts/**

# OS / IDE
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Keep .vscode/ settings
!.vscode/

# CommandCenter agent workspace (auto-managed)
# Agent-generated deliverables are runtime state, never source. Keeping them
# untracked means the local-git mutation flow (git add -A / git reset --hard
# on rejection) can never stage or wipe them, so outputs/ persists across
# redeploys, reboots, and self-mutation rollbacks.
#
# EXCEPTION: the persistent memory bank and working notes ARE source — they must
# travel with the repo so a session can be resumed on another machine. The
# negations below re-include those paths even though their parent dir is ignored.
# Without an explicit carve-out, git silently drops any NEW file written there
# (a plain `git add -A` would miss it — that is how outputs/bangalore-weather.html
# went untracked).
outputs/*
!outputs/_memory/
!outputs/_memory/**
inputs/
agent-data/*
!agent-data/NOTES.md
!agent-data/INDEX.md
